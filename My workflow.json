    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarize these search results clearly using Telegram HTML tags (<b>, <i>, <code>):\n\n{{ JSON.stringify($json.results || $('Search').first().json.results) }}\n\nUser Question: {{ $('Telegram Trigger').first().json.message.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "=Today's Date: {{ $now.format('yyyy-MM-dd') }}\n\nUser Query:\n{{ $('Telegram Trigger').first().json.message.text }}\n\nSearch Results:\n{{ JSON.stringify($json.results || $('Search').first().json.results) }}\n\nTask: Answer the user's query accurately using the search results above. \nIf the user asks for time-sensitive information (like news or recent events), prioritize results published close to today's date.\nFormat output strictly using Telegram HTML tags (<b>, <i>, <code>)."
            }
          ]
        },
        "batching": {}
