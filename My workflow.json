    {
      "parameters": {
        "jsCode": "let text = $json.text || $json.output || \"\";\n\n// Convert <li> to clean bullets and remove </li> / <ul> / <ol>\ntext = text.replace(/<li>/gi, \"• \").replace(/<\\/li>/gi, \"\\n\");\ntext = text.replace(/<\\/?(ul|ol|p|div|br)\\b[^>]*>/gi, \"\");\n\n// Fix any unclosed tags\nlet openB = (text.match(/<b>/g) || []).length;\nlet closeB = (text.match(/<\\/b>/g) || []).length;\nwhile (openB > closeB) { text += \"</b>\"; closeB++; }\n\nlet openI = (text.match(/<i>/g) || []).length;\nlet closeI = (text.match(/<\\/i>/g) || []).length;\nwhile (openI > closeI) { text += \"</i>\"; closeI++; }\n\nreturn [{ json: { text: text.trim() } }];"
      },
