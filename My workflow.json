    {
      "parameters": {
        "jsCode": "const userMessage = $('Telegram Trigger').first().json.message.text;\n\n// Clean out non-math characters except standard operators\nconst expr = userMessage.replace(/[^0-9+\\-*/().^% ]/g, '').trim();\n\nlet ans;\nlet isSuccess = false;\n\nif (expr.length > 0) {\n  try {\n    ans = Function(`\"use strict\"; return (${expr})`)();\n    if (ans !== undefined && !isNaN(ans) && typeof ans === 'number') {\n      isSuccess = true;\n    }\n  } catch (e) {\n    isSuccess = false;\n  }\n}\n\nif (isSuccess) {\n  // Pure math succeeded -> return formatted math result\n  return [{\n    json: {\n      success: true,\n      text: `<b>Math Result:</b> <code>${ans}</code>\\n<i>Expression: ${expr}</i>`\n    }\n  }];\n} else {\n  // Text was involved or math failed -> flag for LLM fallback\n  return [{\n    json: {\n      success: false,\n      userMessage: userMessage\n    }\n  }];\n}"
      },
